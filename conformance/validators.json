{
  "schema_version": "0.1.0",
  "adapters": [
    {
      "id": "dicom3tools-dciodvfy",
      "role": "primary_iod_validator",
      "executable": "dciodvfy",
      "arguments": ["-new", "{input}"],
      "version_arguments": ["--version"],
      "timeout_seconds": 30,
      "required": true,
      "platforms": ["linux", "macos", "windows"],
      "capabilities": ["iod_validation", "normalized_findings"]
    },
    {
      "id": "pydicom-dicom-validator-u32",
      "role": "primary_iod_validator",
      "executable": "python",
      "executable_env": "DTS_DICOM_VALIDATOR_PYTHON",
      "arguments": [
        "-m",
        "dts_dicom_validator_adapter",
        "--lock-path",
        "conformance-backends/dicom-validator/standard-lock.json",
        "{input}"
      ],
      "version_arguments": [
        "-m",
        "dts_dicom_validator_adapter",
        "--version"
      ],
      "pixel_arguments": [
        "-m",
        "dts_dicom_validator_adapter",
        "--pixel-u32",
        "--lock-path",
        "conformance-backends/dicom-validator/standard-lock.json",
        "{input}"
      ],
      "timeout_seconds": 60,
      "required": false,
      "platforms": ["linux", "macos", "windows"],
      "supported_case_ids": ["classic/sc/mono2_u32_explicit_le"],
      "artifacts": [
        {"path": "conformance-backends/dicom-validator/.python-version"},
        {"path": "conformance-backends/dicom-validator/pyproject.toml"},
        {"path": "conformance-backends/dicom-validator/uv.lock"},
        {"path": "conformance-backends/dicom-validator/standard-lock.json"},
        {"path": "conformance-backends/dicom-validator/src/dts_dicom_validator_adapter/__init__.py"},
        {"path": "conformance-backends/dicom-validator/src/dts_dicom_validator_adapter/__main__.py"},
        {"path": "2026b/docbook/part03.xml", "root_env": "DTS_DICOM_VALIDATOR_STANDARD_HOME"},
        {"path": "2026b/docbook/part04.xml", "root_env": "DTS_DICOM_VALIDATOR_STANDARD_HOME"},
        {"path": "2026b/docbook/part06.xml", "root_env": "DTS_DICOM_VALIDATOR_STANDARD_HOME"},
        {"path": "2026b/json/dict_info.json", "root_env": "DTS_DICOM_VALIDATOR_STANDARD_HOME"},
        {"path": "2026b/json/iod_info.json", "root_env": "DTS_DICOM_VALIDATOR_STANDARD_HOME"},
        {"path": "2026b/json/module_info.json", "root_env": "DTS_DICOM_VALIDATOR_STANDARD_HOME"},
        {"path": "2026b/json/uid_info.json", "root_env": "DTS_DICOM_VALIDATOR_STANDARD_HOME"},
        {"path": "2026b/json/version", "root_env": "DTS_DICOM_VALIDATOR_STANDARD_HOME"}
      ],
      "capabilities": [
        "iod_validation",
        "normalized_findings",
        "dicom_2026b_definitions",
        "u32_native_pixel_module"
      ]
    },
    {
      "id": "dicom3tools-dcentvfy",
      "role": "entity_validator",
      "executable": "dcentvfy",
      "arguments": [],
      "version_arguments": ["--version"],
      "timeout_seconds": 120,
      "required": true,
      "platforms": ["linux", "macos", "windows"],
      "capabilities": ["patient_study_series_instance_consistency", "file_list"]
    },
    {
      "id": "dcmtk-dcmdump",
      "role": "independent_parser",
      "executable": "dcmdump",
      "arguments": ["+fo", "{input}"],
      "version_arguments": ["--version"],
      "timeout_seconds": 30,
      "required": true,
      "platforms": ["linux", "macos", "windows"],
      "capabilities": ["part10_parse"]
    },
    {
      "id": "pixelmed-sr-validator",
      "role": "sr_validator",
      "executable": "java",
      "arguments": [
        "-Xmx4g",
        "-XX:-UseGCOverheadLimit",
        "-Djavax.xml.transform.TransformerFactory=net.sf.saxon.TransformerFactoryImpl",
        "-cp",
        "{classpath}",
        "com.pixelmed.validate.DicomSRValidator",
        "-checktemplateid",
        "{input}"
      ],
      "version_arguments": ["-version"],
      "timeout_seconds": 60,
      "required": false,
      "platforms": ["linux", "macos", "windows"],
      "artifact_root_env": "DTS_PIXELMED_HOME",
      "classpath": [
        "pixelmed.jar",
        "lib/additional/commons-codec-1.3.jar",
        "lib/additional/saxon-he-12.5.jar",
        "lib/additional/xmlresolver-5.2.2.jar"
      ],
      "supported_sop_class_uids": [
        "1.2.840.10008.5.1.4.1.1.88.11",
        "1.2.840.10008.5.1.4.1.1.88.33",
        "1.2.840.10008.5.1.4.1.1.88.59"
      ],
      "capabilities": ["sr_iod_validation", "sr_template_validation", "context_group_validation"]
    },
    {
      "id": "dcmtk-dcmdrle",
      "role": "pixel_decoder",
      "executable": "dcmdrle",
      "arguments": ["{input}", "{output}"],
      "version_arguments": ["--version"],
      "timeout_seconds": 60,
      "required": false,
      "platforms": ["linux", "macos", "windows"],
      "capabilities": ["1.2.840.10008.1.2.5", "exact_native_frames", "independent_of_project_rle_encoder"]
    },
    {
      "id": "littlecms-transicc-icc",
      "role": "icc_validator",
      "executable": "transicc",
      "arguments": ["-n", "-i{profile}", "-o*XYZ", "-t0"],
      "version_arguments": ["-v"],
      "timeout_seconds": 60,
      "required": false,
      "platforms": ["macos"],
      "artifacts": [
        {
          "root_env": "DTS_LCMS_HOME",
          "path": "lib/liblcms2.2.dylib"
        }
      ],
      "supported_case_ids": ["vl/photo/rgb_icc_profile_explicit_le"],
      "capabilities": ["icc_v2_input_profile_parse", "rgb_to_xyz_transform", "independent_color_management_engine"]
    },
    {
      "id": "dcmtk-dcm2img-u1",
      "role": "pixel_decoder",
      "executable": "dcm2img",
      "arguments": ["+Fa", "+Fn", "-M", "-W", "+Pid", "-O", "+opn", "1", "{input}", "{output}"],
      "version_arguments": ["--version"],
      "timeout_seconds": 60,
      "required": false,
      "platforms": ["linux", "macos", "windows"],
      "supported_case_ids": ["classic/sc/mono2_u1_native"],
      "capabilities": ["native_single_bit_decode", "continuous_cross_frame_bit_packing", "pgm_sample_evidence"]
    },
    {
      "id": "dcmtk-dcmdjpeg",
      "role": "pixel_decoder",
      "executable": "dcmdjpeg",
      "arguments": ["{input}", "{output}"],
      "version_arguments": ["--version"],
      "timeout_seconds": 60,
      "required": false,
      "platforms": ["linux", "macos", "windows"],
      "capabilities": ["jpeg_decode", "jpeg_ls_decode", "jpeg_2000_decode", "rle_decode"]
    }
  ]
}
