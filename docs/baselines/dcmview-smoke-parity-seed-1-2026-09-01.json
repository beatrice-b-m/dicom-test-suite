      {
        "phase": "R3",
        "fields": ["identity.product.name", "identity.product.version", "binary/crate/library names", "generator implementation_version_name only if the rename/version policy deliberately versions it"],
        "condition": "Must match the accepted synth-dicom-gen 0.2.0 rename and compatibility record; these changes do not permit payload or semantic drift."
      },
      {
        "phase": "R4",
        "fields": ["identity.monolithic_product_resources", "identity.corpus_definition representation", "identity.template_catalog representation", "identity.manifest_schema when explicitly versioned", "identity.corpus_plan_sha256 and per-case resolved_plan_sha256 when only their versioned representation changes"],
        "condition": "Replacement engine, template/provider, corpus-definition, schema, and toolchain identity domains must be explicit and independently recomputable. A changed representation is allowed only when the migration record maps old meaning to new domains and normalized case semantics still match."
      }
    ],
    "versioned_migration_required_for_change": [
      "any output path, file byte SHA-256, or file size",
      "recipe ID/version or template ID/version",
      "case selection, status, profile membership, skipped/unavailable behavior, or counts",
      "SOP Class, transfer syntax, modality, image geometry, pixel representation, photometric interpretation, planar configuration, or pixel/frame hash",
      "study, series, SOP Instance, or reference identity/topology",
      "expected capabilities, semantic expectations, visual pattern, stressors, determinism class, validation result, or standards evidence"
    ],
    "failure_rule": "A deliberate R3/R4 identity-domain difference must be reported separately from parity. Any unlisted difference fails R6.4 unless a reviewed, versioned migration names the affected recipe/template/schema, explains the evidence impact, and establishes a new baseline without converting missing capability into a pass."
