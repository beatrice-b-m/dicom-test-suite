      "prefixes": ["src/sdk/"],
      "exact": ["src/cli_protocol.rs", "src/coverage_gaps.rs", "src/runtime_capabilities.rs", "src/sdk.rs"],
      "bundles": ["sdk"]
    },
    {
      "id": "manifest-contract",
      "exact": ["src/manifest_contract.rs"],
      "bundles": ["assembly", "report", "sdk", "schema"]
    },
    {
      "id": "report-contract",
