    {
      "id": "provider",
      "exact": ["src/recipes/content_provider.rs"],
      "prefixes": ["generation-backends/", "src/generation_backends/"],
      "bundles": ["provider"]
    },
    {
      "id": "resource-cache",
      "exact": ["src/engine_resources.rs"],
      "bundles": ["resource_cache", "schema"]
