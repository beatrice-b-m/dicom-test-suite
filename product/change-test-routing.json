      "deferred": ["explicit_heavy", "release_candidate"]
    },
    {
      "id": "release-manifest-contract",
      "exact": [
        "schemas/release-manifest.schema.json",
        "schemas/release-manifest-v2.schema.json",
        "schemas/release-manifest-v3.schema.json",
        "schemas/capabilities-result-v3.schema.json",
        "scripts/build-release-archive.sh",
        "scripts/validate-release-manifest.sh",
        "scripts/verify-release-archive.sh"
      ],
      "prefixes": ["tests/fixtures/release/"],
      "bundles": ["release_manifest"]
    },
    {
      "id": "product-data",
      "exact": ["product/cli-error-codes.json", "product/compatibility-owners.json"],
