      ".gitignore", "AGENTS.md", "CHANGELOG.md", "CURRENT_PLAN.md", "CURRENT_PROGRESS.md",
      "LICENSE-APACHE", "LICENSE-MIT", "README.md", "SYSTEM_SPEC.md",
