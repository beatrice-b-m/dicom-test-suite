{
  "schema_version": 1,
  "ownership_manifest": "product/test-ownership.json",
  "unconditional_fast_targets": [
    "release_ci__fast",
    "schema_resources__fast"
  ],
  "deferred_evidence": {
    "isolated_sdk_consumer": "Explicit R5 or supported-boundary isolated-source SDK/CLI proof only; not ordinary PR, package, or release qualification.",
    "codec_feature_matrix": "Feature-specific codec compilation and corpus evidence remains in Heavy qualification.",
    "explicit_heavy": "R2.3 ignored byte-parity, all-profile, WSI, and stress entries run only through the heavy dispatcher.",
    "future_external_corpus": "The future corpus repository will own its independent PR workflow after extraction; no sibling path is consulted.",
    "native_provider_contract": "The locked Python provider and ignored process contracts remain in Heavy qualification.",
    "nightly": "Nightly-owned ordinary and ignored entries remain in the scheduled/manual default qualification.",
    "release_candidate": "Packaging, installed SDK, archive, and immutable release evidence remains release-candidate-only.",
    "unrouted_lib_groups": "All-configured-ordinary runs only list-proven representative lib prefixes; remaining ordinary lib groups stay explicit deferred evidence."
  },
  "bundles": {
    "external_corpus_cli": {
      "commands": [
        {"target": "cli_sdk__nonfast", "module": "external_corpus_cli"},
        {"target": "cli_sdk__nonfast", "module": "sdk_corpus"},
        {"target": "cli_sdk__nonfast", "module": "report_cli"}
      ]
    },
    "generic_cr_public_contract": {
      "commands": [{"target": "cli_sdk__nonfast", "module": "external_corpus_cli"}]
    },
    "generic_sc_public_contract": {
      "commands": [{"target": "cli_sdk__nonfast", "module": "external_corpus_cli"}]
    },
    "generic_metadata_sc_public_contract": {
      "commands": [
        {"target": "cli_sdk__nonfast", "module": "external_corpus_cli"}
      ]
    },
    "generic_dx_mg_public_contract": {
      "commands": [
        {"target": "cli_sdk__nonfast", "module": "external_corpus_cli"}
      ]
    },
    "generic_ct_public_contract": {
      "commands": [
        {"target": "cli_sdk__nonfast", "module": "external_corpus_cli"},
        {"target": "cli_sdk__nonfast", "module": "sdk_corpus"}
      ]
    },
    "assembly": {
      "commands": [{"target": "assembly__subsystem"}]
    },
    "codec": {
      "commands": [
        {"kind": "lib", "module": "codecs::tests", "source": "src/codecs.rs", "list_count": 15},
        {"target": "codec__subsystem"}
      ],
      "deferred": ["codec_feature_matrix"]
    },
    "composition": {
      "commands": [{"target": "composition__subsystem", "scope": "ordinary"}],
      "deferred": ["native_provider_contract"]
    },
    "generation_spine_audit": {
      "commands": [
        {"target": "corpus_generation__subsystem", "module": "unified_generation_spine_audit"}
      ]
    },
    "conformance": {
      "commands": [{"target": "conformance_interoperability__subsystem"}]
    },
    "corpus": {
      "commands": [
        {"target": "corpus_generation__subsystem"},
        {"target": "engine__subsystem", "module": "corpus_plan"}
      ],
      "covered_by_fast": ["schema_resources__fast"],
      "deferred": ["explicit_heavy", "future_external_corpus"]
    },
    "captured_corpus_planning": {
      "commands": [
        {"kind": "lib", "module": "curated_plan::captured_input_tests", "source": "tests/captured_curated_plan.rs", "list_count": 4}
      ]
    },
    "captured_corpus_runner": {
      "commands": [
        {"kind": "lib", "module": "corpus_generation::captured_runner_tests", "source": "tests/captured_corpus_generation.rs", "list_count": 6},
        {"kind": "lib", "module": "manifest_contract::external_manifest_contract_tests", "source": "src/manifest_contract.rs", "list_count": 7}
      ]
    },
    "captured_corpus_report": {
      "commands": [
        {"kind": "lib", "module": "corpus_report::captured_report_tests", "source": "tests/captured_corpus_report.rs", "list_count": 3}
      ]
    },
    "corpus_definition_internal": {
      "commands": [
        {"kind": "lib", "module": "corpus_definition::tests", "source": "tests/corpus_definition_bundle.rs", "list_count": 30}
      ]
    },
    "engine": {
      "commands": [
        {"kind": "lib", "module": "executor::evidence::tests", "source": "src/executor/evidence.rs", "list_count": 3},
        {"kind": "lib", "module": "executor::materialization::tests", "source": "src/executor/materialization.rs", "list_count": 16},
        {"kind": "lib", "module": "executor::native_codec::tests", "source": "src/executor/native_codec.rs", "list_count": 1},
        {"kind": "lib", "module": "executor::scheduler::tests", "source": "src/executor/scheduler.rs", "list_count": 9},
        {"kind": "lib", "module": "executor::services::tests", "source": "src/executor/services.rs", "list_count": 5},
        {"kind": "lib", "module": "executor::transaction::tests", "source": "src/executor/transaction.rs", "list_count": 10},
        {"target": "engine__subsystem"}
      ],
      "deferred": ["nightly"]
    },
    "identity": {
      "commands": [
        {"kind": "lib", "module": "identity::identity_domain_tests", "source": "src/identity.rs", "list_count": 4},
        {"target": "cli_sdk__nonfast", "module": "version_cli"},
        {"target": "cli_sdk__nonfast", "module": "capabilities_cli"},
        {"target": "schema_resources__subsystem", "module": "cli_contract_schema"}
      ],
      "covered_by_fast": ["schema_resources__fast"]
    },
    "provider": {
      "commands": [
        {"kind": "lib", "module": "generation_backends::tests", "source": "src/generation_backends/mod.rs", "list_count": 5},
        {"kind": "lib", "module": "generation_backends::discovery::tests", "source": "src/generation_backends/discovery.rs", "list_count": 3},
        {"kind": "lib", "module": "generation_backends::parametric_map::tests", "source": "src/generation_backends/parametric_map.rs", "list_count": 5},
        {"kind": "lib", "module": "generation_backends::process::tests", "source": "src/generation_backends/process.rs", "list_count": 10, "ignored_heavy_skipped": true},
        {"kind": "lib", "module": "generation_backends::scoord3d::tests", "source": "src/generation_backends/scoord3d.rs", "list_count": 4},
        {"kind": "lib", "module": "generation_backends::staging::tests", "source": "src/generation_backends/staging.rs", "list_count": 8},
        {"kind": "lib", "module": "generation_backends::tid1500::caller_parameter_tests", "source": "src/generation_backends/tid1500.rs", "list_count": 1},
        {"target": "provider__subsystem"}
      ],
      "deferred": ["native_provider_contract"]
    },
    "report": {
      "commands": [
        {"kind": "lib", "module": "report_contract::report_contract_tests", "source": "src/report_contract.rs", "list_count": 5},
        {"target": "cli_sdk__nonfast", "module": "report_cli"},
        {"target": "cli_sdk__nonfast", "module": "sdk_facade"}
      ]
    },
    "routing_contract": {
      "commands": [],
      "covered_by_fast": ["release_ci__fast"]
    },
    "release_manifest": {
      "commands": [
        {"target": "release_ci__fast", "module": "ci_release_gates"},
        {"target": "schema_resources__subsystem"}
      ],
      "covered_by_fast": ["release_ci__fast", "schema_resources__fast"],
      "deferred": ["release_candidate"]
    },
    "resource_cache": {
      "commands": [
        {"kind": "lib", "module": "engine_resources::snapshot_cache_tests", "source": "src/engine_resources.rs", "list_count": 7}
      ]
    },
    "schema": {
      "commands": [{"target": "schema_resources__subsystem"}],
      "covered_by_fast": ["schema_resources__fast"]
    },
    "sdk": {
      "commands": [
        {"target": "cli_sdk__nonfast", "module": "sdk_facade"},
        {"target": "cli_sdk__nonfast", "module": "sdk_corpus"},
        {"target": "schema_resources__subsystem", "module": "cli_contract_schema"}
      ]
    },
    "standards": {
      "commands": [{"target": "standards_validation__subsystem"}]
    },
    "byte_stable_validation": {
      "commands": [
        {"kind": "lib", "module": "validation::advanced_blending_presentation_state_tests", "source": "src/validation_advanced_blending_presentation_state_tests.rs", "list_count": 4},
        {"kind": "lib", "module": "validation::blending_presentation_state_tests", "source": "src/validation_blending_presentation_state_tests.rs", "list_count": 3},
        {"kind": "lib", "module": "validation::color_softcopy_presentation_state_tests", "source": "src/validation_color_softcopy_presentation_state_tests.rs", "list_count": 8},
        {"kind": "lib", "module": "validation::general_ecg_tests", "source": "src/validation_general_ecg_tests.rs", "list_count": 3},
        {"kind": "lib", "module": "validation::rt_image_tests", "source": "src/validation_rt_image_tests.rs", "list_count": 4},
        {"kind": "lib", "module": "validation::rt_plan_tests", "source": "src/validation_rt_plan_tests.rs", "list_count": 4},
        {"kind": "lib", "module": "validation::rt_radiation_tests", "source": "src/validation_rt_radiation_tests.rs", "list_count": 4},
        {"kind": "lib", "module": "validation::twelve_lead_ecg_tests", "source": "src/validation_twelve_lead_ecg_tests.rs", "list_count": 6}
      ]
    }
  },
  "rules": [
    {
      "id": "isolated-sdk-consumer-proof",
      "exact": ["scripts/prove-isolated-corpus-consumer.py", "tests/fixtures/isolated-corpus-consumer/main.rs", "tests/test_isolated_corpus_consumer.py"],
      "bundles": ["routing_contract"],
      "deferred": ["isolated_sdk_consumer"]
    },
    {
      "id": "external-corpus-cli",
      "exact": ["src/external_corpus_cli.rs", "src/cli_protocol.rs", "schemas/generation-result-v3.schema.json", "schemas/report-result-v2.schema.json", "schemas/capabilities-result-v3.schema.json"],
      "bundles": ["external_corpus_cli"]
    },
    {
      "id": "global-build",
      "exact": ["Cargo.lock", "Cargo.toml", "build.rs", "src/lib.rs", "src/main.rs"],
      "all_ordinary": true,
      "deferred": ["codec_feature_matrix", "explicit_heavy", "future_external_corpus", "native_provider_contract", "nightly", "release_candidate"]
    },
    {
      "id": "routing-contract",
      "exact": [
        ".github/workflows/ci.yml",
        "product/change-test-routing.json",
        "product/spelling-transition-2026-09-02.json",
        "product/test-ownership.json",
        "scripts/check-spelling-transition.py",
        "scripts/check-test-ownership.py",
        "scripts/route-changed-tests.py",
        "tests/test_change_test_routing.py",
        "tests/test_spelling_transition.py"
      ],
      "bundles": ["routing_contract"],
      "deferred": ["release_candidate"]
    },
    {
      "id": "engine",
      "exact": [
        "src/corpus_plan.rs", "src/fuzz.rs", "src/mutation.rs", "src/negative.rs",
        "src/negative_plan.rs", "src/planning.rs", "src/planning_preview.rs",
        "src/qualification_plan.rs", "src/stress.rs"
      ],
      "prefixes": ["src/executor/"],
      "bundles": ["engine"]
    },
    {
      "id": "codec",
      "exact": [
        "src/codecs.rs", "src/encapsulation.rs", "src/encoded_content.rs",
        "src/executor/frame_codec.rs", "src/executor/native_codec.rs", "src/native_pixel.rs"
