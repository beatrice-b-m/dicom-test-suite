{
  "registry_schema_version": "1.0.0",
  "cli_api_version": "1.0.0",
  "exit_classes": [
    { "exit": 0, "meaning": "command completed successfully" },
    { "exit": 2, "meaning": "command syntax, request parsing, or schema error" },
    { "exit": 3, "meaning": "requested capability or required runtime unavailable" },
    { "exit": 4, "meaning": "output or path conflict, or caller-controlled resource limit" },
    { "exit": 5, "meaning": "generation, validation, conformance, or evidence failure" },
    { "exit": 6, "meaning": "unexpected I/O or internal product failure" }
  ],
  "errors": [
    { "code": "command.syntax.invalid", "exit": 2, "meaning": "unknown command, subcommand, option, format, or malformed option value", "retryable_default": false },
    { "code": "command.argument.missing", "exit": 2, "meaning": "a required command argument or option value is absent", "retryable_default": false },
    { "code": "request.read.failed", "exit": 2, "meaning": "a caller request or explicit configuration file cannot be read", "retryable_default": false },
