    { "code": "validation.manifest.invalid", "exit": 5, "meaning": "the generated manifest is invalid or inconsistent with retained artifacts", "retryable_default": false },
    { "code": "validation.artifact.failed", "exit": 5, "meaning": "one or more retained artifacts failed declared structural, content, or workflow validation", "retryable_default": false },
    { "code": "conformance.tools.failed", "exit": 5, "meaning": "configured conformance tool qualification failed", "retryable_default": false },
    { "code": "conformance.run.failed", "exit": 5, "meaning": "independent conformance execution failed", "retryable_default": false },
