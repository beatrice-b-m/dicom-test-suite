    { "code": "interoperability.qualification.failed", "exit": 5, "meaning": "media or protocol qualification failed its declared evidence contract", "retryable_default": false },
    { "code": "evidence.integrity.failed", "exit": 5, "meaning": "a standards, resource, executable, provider, or artifact identity does not match its locked evidence", "retryable_default": false },
    { "code": "io.read.failed", "exit": 6, "meaning": "an unexpected read failed after input validation", "retryable_default": true },
    { "code": "io.write.failed", "exit": 6, "meaning": "an unexpected staging, serialization, or metadata write failed", "retryable_default": true },
    { "code": "io.cleanup.failed", "exit": 6, "meaning": "private staging or cancellation cleanup failed", "retryable_default": true },
    { "code": "internal.serialization.failed", "exit": 6, "meaning": "the product could not serialize its own public result or error", "retryable_default": false },
    { "code": "internal.invariant.failed", "exit": 6, "meaning": "an unexpected product invariant failed without a more specific public classification", "retryable_default": false }
