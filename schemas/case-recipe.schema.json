    "artifact":{"type":"object","required":["logical_id","order","output","encoding","parameters","attribute_operations","content","validation_rule_ids","projection_rule_ids","determinism","stressors"],"properties":{"logical_id":{"$ref":"#/$defs/id"},"order":{"type":"integer","minimum":0},"template":{"$ref":"#/$defs/template"},"output":{"$ref":"#/$defs/output"},"encoding":{"$ref":"#/$defs/encoding"},"parameters":{"type":"object"},"secondary_capture":{"$ref":"#/$defs/secondary_capture"},"attribute_operations":{"type":"array","items":{"$ref":"#/$defs/attribute_operation"}},"content":{"$ref":"#/$defs/content"},"validation_rule_ids":{"$ref":"#/$defs/rules"},"projection_rule_ids":{"$ref":"#/$defs/rules"},"determinism":{"enum":["byte_stable","semantic_stable"]},"stressors":{"type":"array","items":{"$ref":"#/$defs/id"},"uniqueItems":true},"algorithm_provider_id":{"$ref":"#/$defs/provider_id"}},"additionalProperties":false},
