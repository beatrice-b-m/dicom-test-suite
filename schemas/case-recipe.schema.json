{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://dicom-test-suite.local/schemas/case-recipe.schema.json","type":"object",
  "required":["case_recipe_schema_version","recipe_id","recipe_version","binding","kind","plan_provider_id","provider_parameters","dependencies","validation_rule_ids","projection_rule_ids"],
  "properties":{"case_recipe_schema_version":{"const":"0.1.0"},"recipe_id":{"$ref":"#/$defs/id"},"recipe_version":{"$ref":"#/$defs/semver"},"binding":{"$ref":"#/$defs/binding"},"kind":{"enum":["dicom","mutation","qualification"]},"plan_provider_id":{"$ref":"#/$defs/provider_id"},"provider_parameters":{"type":"object"},"dependencies":{"type":"array","items":{"$ref":"#/$defs/dependency"},"uniqueItems":true},"validation_rule_ids":{"$ref":"#/$defs/rules"},"projection_rule_ids":{"$ref":"#/$defs/rules"},"dicom":{"$ref":"#/$defs/dicom"},"mutation":{"$ref":"#/$defs/mutation"},"qualification":{"$ref":"#/$defs/qualification"}},
  "allOf":[
    {"if":{"properties":{"kind":{"const":"dicom"}},"required":["kind"]},"then":{"required":["dicom"],"not":{"anyOf":[{"required":["mutation"]},{"required":["qualification"]}]}}},
    {"if":{"properties":{"kind":{"const":"mutation"}},"required":["kind"]},"then":{"required":["mutation"],"not":{"anyOf":[{"required":["dicom"]},{"required":["qualification"]}]}}},
    {"if":{"properties":{"kind":{"const":"qualification"}},"required":["kind"]},"then":{"required":["qualification"],"not":{"anyOf":[{"required":["dicom"]},{"required":["mutation"]}]}}}
  ],"additionalProperties":false,
  "$defs":{
    "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9_-]*$","maxLength":160},
    "provider_id":{"type":"string","pattern":"^[a-z][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*)+$","maxLength":200},
    "case_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9_.-]*(/[a-z0-9][a-z0-9_.-]*)+$","maxLength":240},
    "semver":{"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "uid":{"type":"string","pattern":"^[0-9]+(\\.[0-9]+)+$","maxLength":64},
    "path":{"type":"string","minLength":1,"maxLength":512,"pattern":"^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$"},
    "rules":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/provider_id"},"uniqueItems":true},
    "binding":{"type":"object","required":["case_id"],"properties":{"case_id":{"$ref":"#/$defs/case_id"}},"additionalProperties":false},
    "recipe_ref":{"type":"object","required":["recipe_id","recipe_version"],"properties":{"recipe_id":{"$ref":"#/$defs/id"},"recipe_version":{"$ref":"#/$defs/semver"}},"additionalProperties":false},
    "dependency":{"type":"object","required":["recipe","role"],"properties":{"recipe":{"$ref":"#/$defs/recipe_ref"},"role":{"$ref":"#/$defs/id"}},"additionalProperties":false},
    "template":{"type":"object","required":["template_id","template_version"],"properties":{"template_id":{"$ref":"#/$defs/case_id"},"template_version":{"$ref":"#/$defs/semver"}},"additionalProperties":false},
    "output":{"type":"object","required":["role"],"properties":{"role":{"$ref":"#/$defs/id"},"path":{"$ref":"#/$defs/path"},"provider_derived":{"type":"boolean"}},"oneOf":[{"required":["path"]},{"properties":{"provider_derived":{"const":true}},"required":["provider_derived"]}],"additionalProperties":false},
    "encoding":{"type":"object","required":["transfer_syntax_uid","sequence_length_policy","item_length_policy","offset_table_policy","fragmentation_policy"],"properties":{"transfer_syntax_uid":{"$ref":"#/$defs/uid"},"sequence_length_policy":{"enum":["default","defined","undefined","provider"]},"item_length_policy":{"enum":["default","defined","undefined","provider"]},"offset_table_policy":{"enum":["none","empty_basic","populated_basic","extended","provider"]},"fragmentation_policy":{"enum":["native","one_per_frame","bounded_fragments","provider"]},"non_template_encoding_provider_id":{"$ref":"#/$defs/provider_id"}},"additionalProperties":false},
    "attribute_operation":{"type":"object","required":["operation","tag"],"properties":{"operation":{"enum":["set","empty","remove"]},"tag":{"type":"string","pattern":"^[0-9A-F]{4},[0-9A-F]{4}$"},"vr":{"type":"string","pattern":"^[A-Z]{2}$"},"value":{}},"additionalProperties":false},
    "content":{"type":"object","required":["provider_id","parameters"],"properties":{"provider_id":{"$ref":"#/$defs/provider_id"},"parameters":{"type":"object"}},"additionalProperties":false},
    "artifact":{"type":"object","required":["logical_id","order","output","encoding","parameters","attribute_operations","content","validation_rule_ids","projection_rule_ids","determinism","stressors"],"properties":{"logical_id":{"$ref":"#/$defs/id"},"order":{"type":"integer","minimum":0},"template":{"$ref":"#/$defs/template"},"output":{"$ref":"#/$defs/output"},"encoding":{"$ref":"#/$defs/encoding"},"parameters":{"type":"object"},"attribute_operations":{"type":"array","items":{"$ref":"#/$defs/attribute_operation"}},"content":{"$ref":"#/$defs/content"},"validation_rule_ids":{"$ref":"#/$defs/rules"},"projection_rule_ids":{"$ref":"#/$defs/rules"},"determinism":{"enum":["byte_stable","semantic_stable"]},"stressors":{"type":"array","items":{"$ref":"#/$defs/id"},"uniqueItems":true},"algorithm_provider_id":{"$ref":"#/$defs/provider_id"}},"additionalProperties":false},
    "dicom":{"type":"object","required":["artifacts"],"properties":{"artifacts":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/artifact"}}},"additionalProperties":false},
    "edit":{"type":"object","required":["edit_id","mutation_id","parameters"],"properties":{"edit_id":{"$ref":"#/$defs/id"},"mutation_id":{"$ref":"#/$defs/provider_id"},"parameters":{"type":"object"}},"additionalProperties":false},
    "mutation":{"type":"object","required":["source","source_logical_role","edits","failure_layers","acceptable_outcomes","output","retention"],"properties":{"source":{"$ref":"#/$defs/recipe_ref"},"source_logical_role":{"$ref":"#/$defs/id"},"edits":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/edit"}},"failure_layers":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/id"},"uniqueItems":true},"acceptable_outcomes":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/id"},"uniqueItems":true},"output":{"$ref":"#/$defs/output"},"retention":{"const":"expected_invalid_only"}},"additionalProperties":false},
    "resource_policy":{"type":"object","required":["max_input_bytes","max_output_bytes","max_operations"],"properties":{"max_input_bytes":{"type":"integer","minimum":0},"max_output_bytes":{"type":"integer","minimum":0},"max_operations":{"type":"integer","minimum":1}},"additionalProperties":false},
    "qualification":{"type":"object","required":["parameters","resource_policy","retention"],"properties":{"parameters":{"type":"object"},"resource_policy":{"$ref":"#/$defs/resource_policy"},"retention":{"enum":["none","evidence_only"]}},"additionalProperties":false}
  }
}
