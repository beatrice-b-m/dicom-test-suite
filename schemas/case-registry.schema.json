{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dicom-test-suite.local/schemas/case-registry.schema.json",
  "title": "DICOM Test Suite Case Registry",
  "type": "object",
  "required": ["case_registry_schema_version", "cases"],
  "properties": {
    "case_registry_schema_version": {
      "const": "0.1.0"
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)+$"
    },
    "profile": {
      "enum": [
        "smoke",
        "core",
        "extended",
        "legacy",
        "stress",
        "all",
        "negative",
        "fuzz"
      ]
    },
    "status": {
      "enum": ["planned", "implemented", "skipped", "blocked", "deprecated"]
    },
    "determinism": {
      "enum": ["byte_stable", "semantic_stable", "unstable"]
    },
    "case": {
      "type": "object",
      "required": [
        "case_id",
        "status",
        "profiles",
        "recipe_id",
        "recipe_version",
        "iod_name",
        "sop_class_name",
        "sop_class_uid",
        "transfer_syntax_uid",
        "determinism",
        "requirements",
        "skip",
        "standards_evidence"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/case_id"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profile"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "recipe_id": {
          "type": "string"
        },
        "recipe_version": {
          "type": "string"
        },
        "iod_name": {
          "type": "string"
        },
        "sop_class_name": {
          "type": "string"
        },
        "sop_class_uid": {
          "type": "string"
        },
        "modality": {
          "type": "string"
        },
        "transfer_syntax_uid": {
          "type": "string"
        },
        "determinism": {
          "$ref": "#/$defs/determinism"
        },
        "requirements": {
          "$ref": "#/$defs/requirements"
        },
        "skip": {
          "anyOf": [
            {
              "$ref": "#/$defs/skip"
            },
            {
              "type": "null"
            }
          ]
        },
        "standards_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/standards_evidence"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["skipped", "blocked"]
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "skip": {
                "$ref": "#/$defs/skip"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "requirements": {
      "type": "object",
      "required": ["features", "external_codecs", "external_validators"],
      "properties": {
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "external_codecs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "external_validators": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "skip": {
      "type": "object",
      "required": ["reason_code", "message", "recheck_phase"],
      "properties": {
        "reason_code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "recheck_phase": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "standards_evidence": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": {
          "type": "string"
        },
        "edition": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "covered": {
          "type": "boolean"
        },
        "part": {
          "type": "string"
        },
        "anchor": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
