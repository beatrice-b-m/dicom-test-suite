{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dicom-test-suite.local/schemas/case-registry.schema.json",
  "title": "DICOM Test Suite Case Registry",
  "type": "object",
  "required": ["case_registry_schema_version", "cases"],
  "properties": {
    "case_registry_schema_version": {
      "const": "0.2.0"
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)+$"
    },
    "profile": {
      "enum": [
        "smoke",
        "core",
        "extended",
        "legacy",
        "stress",
        "all",
        "negative",
        "fuzz"
      ]
    },
    "status": {
      "enum": ["planned", "implemented", "skipped", "blocked", "deprecated"]
    },
    "determinism": {
      "enum": ["byte_stable", "semantic_stable", "unstable"]
    },
    "case": {
      "type": "object",
      "required": [
        "case_id",
        "artifact_kind",
        "status",
        "provider",
        "object_family",
        "compatibility_axes",
        "roadmap",
        "blockers",
        "profiles",
        "recipe_id",
        "recipe_version",
        "iod_name",
        "sop_class_name",
        "sop_class_uid",
        "transfer_syntax_uid",
        "determinism",
        "requirements",
        "skip",
        "standards_evidence"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/case_id"
        },
        "artifact_kind": {
          "enum": [
            "dicom_instance",
            "media_file_set",
            "transaction_scenario",
            "qualification_fixture",
            "runtime_qualification"
          ]
        },
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "object_family": {
          "$ref": "#/$defs/object_family"
        },
        "compatibility_axes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/compatibility_axis"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "roadmap": {
          "anyOf": [
            {
              "$ref": "#/$defs/roadmap"
            },
            {
              "type": "null"
            }
          ]
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blocker"
          },
          "uniqueItems": true
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profile"
          },
          "uniqueItems": true,
          "allOf": [
            {
              "not": {
                "contains": { "const": "all" }
              }
            },
            {
              "not": {
                "allOf": [
                  { "contains": { "enum": ["negative", "fuzz"] } },
                  {
                    "contains": {
                      "enum": ["smoke", "core", "extended", "legacy", "stress"]
                    }
                  }
                ]
              }
            }
          ]
        },
        "recipe_id": {
          "type": "string"
        },
        "recipe_version": {
          "type": "string"
        },
        "iod_name": {
          "type": ["string", "null"]
        },
        "sop_class_name": {
          "type": ["string", "null"]
        },
        "sop_class_uid": {
          "type": ["string", "null"]
        },
        "modality": {
          "type": ["string", "null"]
        },
        "transfer_syntax_uid": {
          "type": ["string", "null"]
        },
        "determinism": {
          "$ref": "#/$defs/determinism"
        },
        "requirements": {
          "$ref": "#/$defs/requirements"
        },
        "skip": {
          "anyOf": [
            {
              "$ref": "#/$defs/skip"
            },
            {
              "type": "null"
            }
          ]
        },
        "standards_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/standards_evidence"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "artifact_kind": {
                "enum": ["dicom_instance", "media_file_set"]
              }
            },
            "required": ["artifact_kind"]
          },
          "then": {
            "properties": {
              "profiles": {
                "minItems": 1
              },
              "iod_name": {
                "type": "string"
              },
              "sop_class_name": {
                "type": "string"
              },
              "sop_class_uid": {
                "type": "string"
              },
              "transfer_syntax_uid": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "artifact_kind": {
                "const": "qualification_fixture"
              }
            },
            "required": ["artifact_kind"]
          },
          "then": {
            "properties": {
              "profiles": {
                "maxItems": 0
              },
              "iod_name": {
                "type": "null"
              },
              "sop_class_name": {
                "type": "null"
              },
              "sop_class_uid": {
                "type": "null"
              },
              "modality": {
                "type": "null"
              },
              "transfer_syntax_uid": {
                "type": "null"
              },
              "standards_evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "artifact_kind": {
                "const": "transaction_scenario"
              }
            },
            "required": ["artifact_kind"]
          },
          "then": {
            "properties": {
              "profiles": {
                "maxItems": 0
              },
              "iod_name": {
                "type": "null"
              },
              "sop_class_name": {
                "type": "null"
              },
              "sop_class_uid": {
                "type": "null"
              },
              "transfer_syntax_uid": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "artifact_kind": {
                "const": "runtime_qualification"
              }
            },
            "required": ["artifact_kind"]
          },
          "then": {
            "properties": {
              "profiles": {
                "minItems": 1
              },
              "iod_name": {
                "type": "null"
              },
              "sop_class_name": {
                "type": "null"
              },
              "sop_class_uid": {
                "type": "null"
              },
              "modality": {
                "type": "null"
              },
              "transfer_syntax_uid": {
                "type": "null"
              },
              "standards_evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["skipped", "blocked"]
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "skip": {
                "$ref": "#/$defs/skip"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "implemented"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "roadmap": {
                "type": "null"
              },
              "blockers": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["planned", "blocked"]
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "roadmap": {
                "$ref": "#/$defs/roadmap"
              },
              "blockers": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": [
            "rust_native",
            "external_backend",
            "mutation_layer",
            "protocol_harness"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        }
      },
      "additionalProperties": false
    },
    "object_family": {
      "enum": [
        "classic_image",
        "enhanced_image",
        "derived_image",
        "quantitative",
        "presentation_state",
        "structured_report",
        "radiotherapy",
        "waveform",
        "registration",
        "mesh",
        "visible_light",
        "encapsulated_document",
        "media",
        "robustness",
        "protocol"
      ]
    },
    "compatibility_axis": {
      "enum": [
        "geometry",
        "metadata",
        "modality",
        "pixels",
        "quantitative",
        "references",
        "registration",
        "presentation",
        "structured_report",
        "radiotherapy",
        "waveform",
        "mesh",
        "visible_light",
        "encapsulation",
        "compression",
        "scale",
        "robustness",
        "media",
        "protocol",
        "security"
      ]
    },
    "roadmap": {
      "type": "object",
      "required": ["priority", "delivery_phase", "rationale"],
      "properties": {
        "priority": {
          "enum": ["now", "next", "later"]
        },
        "delivery_phase": {
          "type": "string",
          "pattern": "^phase-[1-8]$"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "blocker_code": {
      "enum": [
        "recipe_unimplemented",
        "standards_verification_pending",
        "backend_contract_unimplemented",
        "backend_unavailable",
        "provider_capability_unavailable",
        "independent_iod_validator_unavailable",
        "independent_payload_validator_unavailable",
        "independent_decoder_unavailable",
        "numeric_tolerance_policy_pending",
        "stress_budget_policy_pending",
        "mutation_contract_unimplemented",
        "protocol_harness_unimplemented",
        "security_toolchain_unselected",
        "decision_checkpoint"
      ]
    },
    "blocker": {
      "type": "object",
      "required": ["code", "message", "recheck_phase"],
      "properties": {
        "code": {
          "$ref": "#/$defs/blocker_code"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "recheck_phase": {
          "type": ["string", "null"],
          "pattern": "^phase-[1-8]$"
        }
      },
      "additionalProperties": false
    },
    "requirements": {
      "type": "object",
      "required": ["features", "external_codecs", "external_validators"],
      "properties": {
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "external_codecs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "external_validators": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "skip": {
      "type": "object",
      "required": ["reason_code", "message", "recheck_phase"],
      "properties": {
        "reason_code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "recheck_phase": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "standards_evidence": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": {
          "type": "string"
        },
        "edition": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "covered": {
          "type": "boolean"
        },
        "part": {
          "type": "string"
        },
        "anchor": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
