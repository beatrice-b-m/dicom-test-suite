{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dicom-test-suite.local/schemas/cli-success-envelope.schema.json",
  "title": "DICOM Test Suite CLI Success Envelope",
  "type": "object",
  "required": ["cli_api_version", "command", "status", "result"],
  "properties": {
    "cli_api_version": { "const": "1.0.0" },
    "command": { "$ref": "#/$defs/command" },
    "status": { "const": "success" },
    "result": { "type": "object" }
  },
  "additionalProperties": false,
  "$defs": {
    "command": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*( [a-z][a-z0-9-]*)?$",
      "maxLength": 96
    }
  }
}
