{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dicom-test-suite.local/schemas/composition-provider-response.schema.json",
  "title": "DICOM Composition Content Provider Response",
  "type": "object",
  "required": [
    "protocol_version", "request_id", "provider_id", "provider_version",
    "executable_sha256", "argument_sha256", "output"
  ],
  "properties": {
    "protocol_version": { "const": "1.0.0" },
    "request_id": { "$ref": "#/$defs/sha256" },
    "provider_id": { "$ref": "#/$defs/id" },
    "provider_version": { "$ref": "#/$defs/semver" },
    "executable_sha256": { "$ref": "#/$defs/sha256" },
    "argument_sha256": { "$ref": "#/$defs/sha256" },
    "output": {
      "type": "object",
      "required": ["slot", "relative_path", "size_bytes", "sha256"],
      "properties": {
        "slot": { "$ref": "#/$defs/id" },
        "relative_path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "maxLength": 128
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
