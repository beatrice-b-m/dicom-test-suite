{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dicom-test-suite.local/schemas/composition-spec.schema.json",
  "title": "DICOM Test Suite Composition Specification",
  "type": "object",
  "required": ["composition_spec_schema_version", "instances"],
  "properties": {
    "composition_spec_schema_version": { "const": "0.1.0" },
    "defaults": { "$ref": "#/$defs/run_defaults" },
    "instances": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/instance" }
    },
    "resource_limits": { "$ref": "#/$defs/resource_limits" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "maxLength": 128
    },
    "template_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*(/[a-z0-9][a-z0-9_.-]*)*$",
      "maxLength": 160
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "uid": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)+$",
      "maxLength": 64
    },
    "tag": {
      "type": "string",
      "pattern": "^[0-9A-F]{4},[0-9A-F]{4}$"
    },
    "vr": {
      "enum": [
        "AE", "AS", "AT", "CS", "DA", "DS", "DT", "FD", "FL", "IS",
        "LO", "LT", "OB", "OD", "OF", "OL", "OV", "OW", "PN", "SH",
        "SL", "SQ", "SS", "ST", "SV", "TM", "UC", "UI", "UL", "UN",
        "UR", "US", "UT", "UV"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safe_relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "allOf": [
        { "not": { "pattern": "^/" } },
        { "not": { "pattern": "(^|/)\\.\\.?(/|$)" } },
        { "not": { "pattern": "[\\\\:]" } },
        { "not": { "pattern": "\\u0000" } }
      ]
    },
    "run_defaults": {
      "type": "object",
      "properties": {
        "patient": { "$ref": "#/$defs/attribute_scope" },
        "study": { "$ref": "#/$defs/attribute_scope" },
        "series": { "$ref": "#/$defs/attribute_scope" },
        "equipment": { "$ref": "#/$defs/attribute_scope" },
        "transfer_syntax_uid": { "$ref": "#/$defs/uid" }
      },
      "additionalProperties": false
    },
    "attribute_scope": {
      "type": "object",
      "required": ["attributes"],
      "properties": {
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/$defs/attribute_operation" }
        }
      },
      "additionalProperties": false
    },
    "instance": {
      "type": "object",
      "required": ["instance_id", "template"],
      "properties": {
        "instance_id": { "$ref": "#/$defs/id" },
        "template": { "$ref": "#/$defs/template_selector" },
        "transfer_syntax_uid": { "$ref": "#/$defs/uid" },
        "identities": { "$ref": "#/$defs/identities" },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/$defs/attribute_operation" }
        },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/content_assignment" }
        },
        "references": {
          "type": "array",
          "items": { "$ref": "#/$defs/reference" }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "template_selector": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/template_id" },
        "version": { "$ref": "#/$defs/semver" }
      },
      "additionalProperties": false
    },
    "identity_choice": {
      "oneOf": [
        {
          "type": "object",
          "required": ["auto"],
          "properties": { "auto": { "const": true } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["uid"],
          "properties": { "uid": { "$ref": "#/$defs/uid" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["share_with"],
          "properties": { "share_with": { "$ref": "#/$defs/id" } },
          "additionalProperties": false
        }
      ]
    },
    "identities": {
      "type": "object",
      "properties": {
        "patient": { "$ref": "#/$defs/identity_choice" },
        "study": { "$ref": "#/$defs/identity_choice" },
        "series": { "$ref": "#/$defs/identity_choice" },
        "sop_instance": { "$ref": "#/$defs/identity_choice" },
        "frame_of_reference": { "$ref": "#/$defs/identity_choice" }
      },
      "additionalProperties": false
    },
    "attribute_address": {
      "oneOf": [
        {
          "type": "object",
          "required": ["tag"],
          "properties": { "tag": { "$ref": "#/$defs/tag" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["keyword"],
          "properties": {
            "keyword": {
              "type": "string",
              "pattern": "^[A-Z][A-Za-z0-9]*$",
              "maxLength": 128
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["tag", "private_creator"],
          "properties": {
            "tag": { "$ref": "#/$defs/tag" },
            "private_creator": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "attribute_operation": {
      "oneOf": [
        {
          "type": "object",
          "required": ["address", "operation", "vr", "value"],
          "properties": {
            "address": { "$ref": "#/$defs/attribute_address" },
            "operation": { "const": "set" },
            "vr": { "$ref": "#/$defs/vr" },
            "value": { "$ref": "#/$defs/attribute_value" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["address", "operation"],
          "properties": {
            "address": { "$ref": "#/$defs/attribute_address" },
            "operation": { "const": "empty" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["address", "operation"],
          "properties": {
            "address": { "$ref": "#/$defs/attribute_address" },
            "operation": { "const": "remove" }
          },
          "additionalProperties": false
        }
      ]
    },
    "scalar_value": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "string" },
            "value": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "integer" },
            "value": { "type": "integer" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "number" },
            "value": { "type": "number" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "tag" },
            "value": { "$ref": "#/$defs/tag" }
          },
          "additionalProperties": false
        }
      ]
    },
    "attribute_value": {
      "oneOf": [
        { "$ref": "#/$defs/scalar_value" },
        {
          "type": "object",
          "required": ["kind", "values"],
          "properties": {
            "kind": { "const": "multi" },
            "values": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/scalar_value" }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "items"],
          "properties": {
            "kind": { "const": "sequence" },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["attributes"],
                "properties": {
                  "attributes": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/attribute_operation" }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "base64"],
          "properties": {
            "kind": { "const": "binary" },
            "base64": {
              "type": "string",
              "contentEncoding": "base64",
              "maxLength": 87384
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "content_assignment": {
      "type": "object",
      "required": ["slot", "source"],
      "properties": {
        "slot": { "$ref": "#/$defs/id" },
        "source": { "$ref": "#/$defs/content_source" }
      },
      "additionalProperties": false
    },
    "content_source": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "default" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "local_file" },
            "path": { "$ref": "#/$defs/safe_relative_path" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "media_type": { "type": "string", "minLength": 1, "maxLength": 255 },
            "pixel": { "$ref": "#/$defs/pixel_declaration" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "base64"],
          "properties": {
            "kind": { "const": "inline_small_fixture" },
            "base64": {
              "type": "string",
              "contentEncoding": "base64",
              "maxLength": 87384
            },
            "sha256": { "$ref": "#/$defs/sha256" },
            "media_type": { "type": "string", "minLength": 1, "maxLength": 255 },
            "pixel": { "$ref": "#/$defs/pixel_declaration" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "transfer_syntax_uid", "frames"],
          "properties": {
            "kind": { "const": "encoded_frames" },
            "transfer_syntax_uid": { "$ref": "#/$defs/uid" },
            "frames": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["path"],
                "properties": {
                  "path": { "$ref": "#/$defs/safe_relative_path" },
                  "sha256": { "$ref": "#/$defs/sha256" }
                },
                "additionalProperties": false
              }
            },
            "pixel": { "$ref": "#/$defs/pixel_declaration" }
          },
          "additionalProperties": false
        }
      ]
    },
    "pixel_declaration": {
      "type": "object",
      "required": [
        "rows", "columns", "frames", "samples_per_pixel", "photometric_interpretation",
        "sample_type", "bits_allocated", "bits_stored", "high_bit", "byte_order"
      ],
      "properties": {
        "rows": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "columns": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "frames": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "samples_per_pixel": { "enum": [1, 3] },
        "photometric_interpretation": {
          "enum": ["MONOCHROME1", "MONOCHROME2", "PALETTE COLOR", "RGB", "YBR_FULL", "YBR_FULL_422"]
        },
        "sample_type": { "enum": ["uint", "int", "float32", "float64", "bit1"] },
        "bits_allocated": { "enum": [1, 8, 16, 32, 64] },
        "bits_stored": { "type": "integer", "minimum": 1, "maximum": 64 },
        "high_bit": { "type": "integer", "minimum": 0, "maximum": 63 },
        "byte_order": { "enum": ["little", "big"] },
        "planar_configuration": { "enum": [0, 1] }
      },
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "required": ["role", "target_instance_id"],
      "properties": {
        "role": { "$ref": "#/$defs/id" },
        "target_instance_id": { "$ref": "#/$defs/id" },
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "resource_limits": {
      "type": "object",
      "properties": {
        "max_instances": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "max_input_files": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "max_file_bytes": { "type": "integer", "minimum": 1 },
        "max_total_input_bytes": { "type": "integer", "minimum": 1 },
        "max_total_output_bytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  }
}
