{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dicom-test-suite.local/schemas/conformance-run.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "created_at", "repository", "source",
    "generator", "host", "tools", "instances", "entity", "summary"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "run_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "repository": { "$ref": "#/$defs/repository" },
    "source": { "$ref": "#/$defs/source" },
    "generator": { "$ref": "#/$defs/generator" },
    "host": { "$ref": "#/$defs/host" },
    "tools": { "type": "array", "items": { "$ref": "#/$defs/tool" } },
    "instances": { "type": "array", "items": { "$ref": "#/$defs/instance" } },
    "entity": { "$ref": "#/$defs/result" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relative_path": {
      "type": "string", "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": { "type": "string", "minLength": 7 },
        "dirty": { "type": "boolean" }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_path", "manifest_sha256"],
      "properties": {
        "manifest_path": { "$ref": "#/$defs/relative_path" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "generator": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "seed", "profile", "features", "standards_lock_sha256"],
      "properties": {
        "identity": { "type": "string", "minLength": 1 },
        "seed": { "type": "integer", "minimum": 0 },
        "profile": { "type": "string", "minLength": 1 },
        "features": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "standards_lock_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "host": {
      "type": "object", "additionalProperties": false,
      "required": ["os", "architecture"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 }
      }
    },
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter_id", "role", "status", "required", "executable", "sha256", "lock_status"],
      "properties": {
        "adapter_id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "status": { "enum": ["available", "absent", "misconfigured", "unsupported", "timeout"] },
        "required": { "type": "boolean" },
        "executable": { "type": ["string", "null"] },
        "sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "executable_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "version_output": { "type": ["string", "null"] },
        "version_exit_code": { "type": ["integer", "null"] },
        "lock_status": { "enum": ["matched", "mismatched", "unlocked", "unavailable"] }
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relative_path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["severity", "message", "message_fingerprint", "disposition"],
      "properties": {
        "severity": { "enum": ["error", "warning", "info", "tool_failure", "timeout", "unsupported", "unparsed_output"] },
        "rule_id": { "type": ["string", "null"] },
        "message": { "type": "string", "minLength": 1 },
        "message_fingerprint": { "$ref": "#/$defs/sha256" },
        "dicom_path": { "type": ["string", "null"] },
        "disposition": { "enum": ["unresolved", "accepted"] }
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter_id", "role", "status", "invocation", "stdout", "stderr", "exit_code", "duration_ms", "timed_out", "findings"],
      "properties": {
        "adapter_id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "status": { "enum": ["completed", "tool_failure", "timeout", "unsupported"] },
        "invocation": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "stdout": { "$ref": "#/$defs/artifact" },
        "stderr": { "$ref": "#/$defs/artifact" },
        "exit_code": { "type": ["integer", "null"] },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "timed_out": { "type": "boolean" },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "unsupported_reason": { "type": "string", "minLength": 1 }
      }
    },
    "pixel": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "independence", "expected_frame_hashes", "actual_frame_hashes", "evidence"],
      "properties": {
        "status": { "enum": ["passed", "failed", "unsupported"] },
        "independence": { "enum": ["independent", "same_implementation", "not_applicable"] },
        "expected_frame_hashes": { "type": "array", "items": { "$ref": "#/$defs/sha256" } },
        "actual_frame_hashes": { "type": "array", "items": { "$ref": "#/$defs/sha256" } },
        "reason": { "type": "string" },
        "evidence": { "anyOf": [{ "$ref": "#/$defs/artifact" }, { "type": "null" }] }
      }
    },
    "instance": {
      "type": "object", "additionalProperties": false,
      "required": ["stable_instance_key", "case_id", "path", "sop_class_uid", "transfer_syntax_uid", "results", "pixel"],
      "properties": {
        "stable_instance_key": { "$ref": "#/$defs/sha256" },
        "case_id": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/relative_path" },
        "sop_class_uid": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)+$" },
        "transfer_syntax_uid": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)+$" },
        "results": { "type": "array", "items": { "$ref": "#/$defs/result" } },
        "pixel": { "$ref": "#/$defs/pixel" }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["instances", "by_severity", "by_disposition", "by_tool", "by_sop_class", "by_transfer_syntax"],
      "properties": {
        "instances": { "type": "integer", "minimum": 0 },
        "by_severity": { "$ref": "#/$defs/counts" },
        "by_disposition": { "$ref": "#/$defs/counts" },
        "by_tool": { "$ref": "#/$defs/counts" },
        "by_sop_class": { "$ref": "#/$defs/counts" },
        "by_transfer_syntax": { "$ref": "#/$defs/counts" }
      }
    },
    "counts": {
      "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 }
    }
  }
}
