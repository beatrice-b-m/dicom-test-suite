    ],
    "grouped_negative_coverage": [
      "negative_coverage"
    ],
    "fuzz_coverage": [
      "grouped_fuzz_coverage"
    ],
    "grouped_fuzz_coverage": [
      "fuzz_coverage"
    ],
    "stress_coverage": [
      "grouped_stress_coverage"
    ],
    "grouped_stress_coverage": [
      "stress_coverage"
    ]
