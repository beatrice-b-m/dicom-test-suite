{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synth-dicom-gen.local/schemas/coverage-report-v2.schema.json",
  "title": "External corpus definition-driven report v2",
  "type": "object",
  "required": ["coverage_report_schema_version", "report_kind", "evidence", "identity_projection", "source_manifest", "summary", "case_dimensions", "artifact_dimensions", "coverage_matrix", "grouped_coverage"],
  "properties": {
    "coverage_report_schema_version": {"const": "2.0.0"},
    "report_kind": {"const": "external_corpus"},
    "evidence": {"const": {"class": "manifest_projection", "validation": "not_assessed", "independent_conformance": "not_assessed", "payloads_reopened": false}},
    "identity_projection": {"$ref": "https://synth-dicom-gen.local/schemas/manifest-v1.schema.json#/$defs/identity_projection"},
    "source_manifest": {"$ref": "https://synth-dicom-gen.local/schemas/manifest-v2.schema.json"},
    "summary": {
      "type": "object",
      "required": ["logical_cases", "direct_cases", "dependency_cases", "emitted_files", "qualifications", "outcomes"],
      "properties": {
        "logical_cases": {"$ref": "#/$defs/count"},
        "direct_cases": {"$ref": "#/$defs/count"},
        "dependency_cases": {"$ref": "#/$defs/count"},
        "emitted_files": {"$ref": "#/$defs/count"},
        "qualifications": {"$ref": "#/$defs/count"},
        "outcomes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/count"}}
      },
      "additionalProperties": false
    },
    "case_dimensions": {"$ref": "#/$defs/dimensions"},
    "artifact_dimensions": {"$ref": "#/$defs/dimensions"},
    "coverage_matrix": {
      "type": "array",
      "items": {"$ref": "#/$defs/coverage_row"}
    },
    "grouped_coverage": {"$ref": "https://dicom-test-suite.local/schemas/coverage-report.schema.json#/properties/grouped_coverage"}
  },
  "additionalProperties": false,
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "coverage_row": {
      "type": "object",
      "required": [
        "case_id", "status", "nonsquare_variant_id", "nonsquare_pixel_spacing",
        "nonsquare_nominal_scanned_pixel_spacing", "nonsquare_pixel_aspect_ratio",
        "nonsquare_uncalibrated", "nonsquare_patient_space_geometry_present",
        "nonsquare_pixel_data_sha256", "pixel_spacing", "imager_pixel_spacing",
        "u32_stored_values", "u32_pixel_data_sha256", "u32_word_byte_order", "u32_full_unsigned_range", "u1_stored_values", "u1_decoded_frame_sha256", "u1_pixel_data_sha256", "u1_packing_order", "u1_frame_boundary_policy", "u1_significant_bits", "u1_unused_high_bits", "u1_value_field_padding_bytes"
      ],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "nonsquare_variant_id": {"type": ["string", "null"]},
        "nonsquare_pixel_spacing": {"type": ["string", "null"]},
        "nonsquare_nominal_scanned_pixel_spacing": {"type": ["string", "null"]},
        "nonsquare_pixel_aspect_ratio": {"type": ["string", "null"]},
        "nonsquare_uncalibrated": {"type": ["boolean", "null"]},
        "nonsquare_patient_space_geometry_present": {"type": ["boolean", "null"]},
        "nonsquare_pixel_data_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "pixel_spacing": {"type": ["string", "null"]},
        "imager_pixel_spacing": {"type": ["string", "null"]},
        "u32_stored_values": {"type": ["string", "null"]},
        "u32_pixel_data_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "u32_word_byte_order": {"enum": ["little_endian", null]},
        "u32_full_unsigned_range": {"type": ["boolean", "null"]},
        "u1_stored_values": {"type": ["string", "null"]},
        "u1_decoded_frame_sha256": {"type": ["string", "null"]},
        "u1_pixel_data_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "u1_packing_order": {"enum": ["least_significant_bit_first", null]},
        "u1_frame_boundary_policy": {"enum": ["continuous_without_per_frame_padding", null]},
        "u1_significant_bits": {"type": ["integer", "null"], "minimum": 1},
        "u1_unused_high_bits": {"type": ["integer", "null"], "minimum": 0, "maximum": 7},
        "u1_value_field_padding_bytes": {"type": ["integer", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["value", "count", "members"],
        "properties": {
          "value": {"type": "string"},
          "count": {"$ref": "#/$defs/count"},
          "members": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "dimensions": {
      "type": "object",
      "required": ["profiles", "modalities", "sop_classes", "transfer_syntaxes", "determinism", "providers"],
      "properties": {
        "profiles": {"$ref": "#/$defs/groups"},
        "modalities": {"$ref": "#/$defs/groups"},
        "sop_classes": {"$ref": "#/$defs/groups"},
        "transfer_syntaxes": {"$ref": "#/$defs/groups"},
        "determinism": {"$ref": "#/$defs/groups"},
        "providers": {"$ref": "#/$defs/groups"}
      },
      "additionalProperties": false
    }
  }
}
