{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synth-dicom-gen.local/schemas/generation-backend-request.schema.json",
  "title": "DICOM External Generation Backend Request",
  "type": "object",
  "required": [
    "request_schema_version",
    "protocol_version",
    "request_id",
    "backend_id",
    "case",
    "run",
    "standards",
    "staging",
    "identities",
    "controlled_metadata",
    "sources",
    "parameters",
    "requested_determinism"
  ],
  "properties": {
    "request_schema_version": { "const": "0.1.0" },
    "protocol_version": { "const": "0.1.0" },
    "request_id": { "$ref": "#/$defs/sha256" },
    "backend_id": { "$ref": "#/$defs/id" },
    "case": { "$ref": "#/$defs/case" },
    "run": { "$ref": "#/$defs/run" },
    "standards": { "$ref": "#/$defs/standards" },
    "staging": { "$ref": "#/$defs/staging" },
    "identities": { "$ref": "#/$defs/identities" },
    "controlled_metadata": { "$ref": "#/$defs/controlled_metadata" },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" },
      "uniqueItems": true
    },
    "parameters": { "type": "object" },
    "requested_determinism": { "$ref": "#/$defs/determinism" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uid": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)+$",
      "maxLength": 64
    },
    "determinism": {
      "enum": ["byte_stable", "semantic_stable", "unstable"]
    },
    "case": {
      "type": "object",
      "required": [
        "case_id",
        "recipe_id",
        "recipe_version",
        "profile",
        "expected_sop_class_uid",
        "expected_transfer_syntax_uid"
      ],
      "properties": {
        "case_id": { "type": "string" },
        "recipe_id": { "$ref": "#/$defs/id" },
        "recipe_version": { "type": "string" },
        "profile": {
          "enum": ["smoke", "core", "extended", "legacy", "stress"]
        },
        "expected_sop_class_uid": { "$ref": "#/$defs/uid" },
        "expected_transfer_syntax_uid": { "$ref": "#/$defs/uid" }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": ["seed"],
      "properties": {
        "seed": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "standards": {
      "type": "object",
      "required": [
        "standards_lock_sha256",
        "dicom_base_edition",
        "kb_source_manifest_sha256"
      ],
      "properties": {
        "standards_lock_sha256": { "$ref": "#/$defs/sha256" },
        "dicom_base_edition": { "type": "string" },
        "kb_source_manifest_sha256": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "staging": {
      "type": "object",
      "required": ["root", "inputs_directory", "output_directory"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "inputs_directory": { "type": "string", "minLength": 1 },
        "output_directory": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "uid_slot": {
      "type": "object",
      "required": ["role", "index", "uid"],
      "properties": {
        "role": { "$ref": "#/$defs/id" },
        "index": { "type": "integer", "minimum": 0 },
        "uid": { "$ref": "#/$defs/uid" }
      },
      "additionalProperties": false
    },
    "identities": {
      "type": "object",
      "required": [
        "study_instance_uid",
        "series_instance_uid",
        "frame_of_reference_uid",
        "sop_instances"
      ],
      "properties": {
        "study_instance_uid": { "$ref": "#/$defs/uid" },
        "series_instance_uid": { "$ref": "#/$defs/uid" },
        "frame_of_reference_uid": {
          "anyOf": [
            { "$ref": "#/$defs/uid" },
            { "type": "null" }
          ]
        },
        "sop_instances": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/uid_slot" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "controlled_metadata": {
      "type": "object",
      "required": [
        "patient_name",
        "patient_id",
        "manufacturer",
        "model_name",
        "software_versions",
        "study_date",
        "study_time",
        "content_date",
        "content_time",
        "timezone_offset_from_utc"
      ],
      "properties": {
        "patient_name": { "type": "string" },
        "patient_id": { "type": "string" },
        "manufacturer": { "type": "string" },
        "model_name": { "type": "string" },
        "software_versions": { "type": "string" },
        "study_date": { "type": "string" },
        "study_time": { "type": "string" },
        "content_date": { "type": "string" },
        "content_time": { "type": "string" },
        "timezone_offset_from_utc": { "type": "string" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "role",
        "source_case_id",
        "relative_path",
        "sha256",
        "sop_class_uid",
        "sop_instance_uid",
        "series_instance_uid",
        "frame_numbers"
      ],
      "properties": {
        "role": { "$ref": "#/$defs/id" },
        "source_case_id": { "type": "string" },
        "relative_path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sop_class_uid": { "$ref": "#/$defs/uid" },
        "sop_instance_uid": { "$ref": "#/$defs/uid" },
        "series_instance_uid": {
          "anyOf": [
            { "$ref": "#/$defs/uid" },
            { "type": "null" }
          ]
        },
        "frame_numbers": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": { "type": "integer", "minimum": 1 },
              "uniqueItems": true
            },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
