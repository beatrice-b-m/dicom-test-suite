{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synth-dicom-gen.local/schemas/generation-backend-response.schema.json",
  "title": "DICOM External Generation Backend Response",
  "type": "object",
  "required": [
    "response_schema_version",
    "protocol_version",
    "request_id",
    "backend_id",
    "status",
    "backend",
    "outputs",
    "warnings",
    "failure"
  ],
  "properties": {
    "response_schema_version": { "const": "0.1.0" },
    "protocol_version": { "const": "0.1.0" },
    "request_id": { "$ref": "#/$defs/sha256" },
    "backend_id": { "$ref": "#/$defs/id" },
    "status": { "enum": ["generated", "unavailable", "failed"] },
    "backend": { "$ref": "#/$defs/backend" },
    "outputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/output" },
      "uniqueItems": true
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/message" }
    },
    "failure": {
      "anyOf": [
        { "$ref": "#/$defs/failure" },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "generated" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "outputs": { "minItems": 1 },
          "failure": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["unavailable", "failed"] } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "outputs": { "maxItems": 0 },
          "failure": { "$ref": "#/$defs/failure" }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uid": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)+$",
      "maxLength": 64
    },
    "backend": {
      "type": "object",
      "required": [
        "name",
        "version",
        "dependency_lock_sha256",
        "executable_fingerprint",
        "environment_fingerprint"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "dependency_lock_sha256": { "$ref": "#/$defs/sha256" },
        "executable_fingerprint": { "$ref": "#/$defs/sha256" },
        "environment_fingerprint": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "required": [
        "role",
        "relationship",
        "sop_class_uid",
        "sop_instance_uid",
        "series_instance_uid",
        "frame_numbers"
      ],
      "properties": {
        "role": { "$ref": "#/$defs/id" },
        "relationship": { "$ref": "#/$defs/id" },
        "sop_class_uid": { "$ref": "#/$defs/uid" },
        "sop_instance_uid": { "$ref": "#/$defs/uid" },
        "series_instance_uid": {
          "anyOf": [
            { "$ref": "#/$defs/uid" },
            { "type": "null" }
          ]
        },
        "frame_numbers": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": { "type": "integer", "minimum": 1 },
              "uniqueItems": true
            },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [
        "relative_path",
        "sop_class_uid",
        "sop_instance_uid",
        "transfer_syntax_uid",
        "references",
        "expected_semantics",
        "payload_expectations"
      ],
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "sop_class_uid": { "$ref": "#/$defs/uid" },
        "sop_instance_uid": { "$ref": "#/$defs/uid" },
        "transfer_syntax_uid": { "$ref": "#/$defs/uid" },
        "references": {
          "type": "array",
          "items": { "$ref": "#/$defs/reference" },
          "uniqueItems": true
        },
        "expected_semantics": { "type": "object" },
        "payload_expectations": { "type": "object" }
      },
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/id" },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "enum": [
            "dependency_unavailable",
            "case_unsupported",
            "generation_failed"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
