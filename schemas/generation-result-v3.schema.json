{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synth-dicom-gen.local/schemas/generation-result-v3.schema.json",
  "title": "External Corpus Generation Result v3",
  "type": "object",
  "required": [
    "generation_result_schema_version",
    "outcome",
    "requested_output_root",
    "manifest_path",
    "run_kind",
    "seed",
    "profile",
    "include_stress",
    "selector",
    "request_schema_version",
    "manifest_schema_version",
    "product_version",
    "identity_projection",
    "selection_ledger",
    "corpus_plan_sha256",
    "emitted_file_count",
    "output_bytes",
    "selected_case_count",
    "direct_case_count",
    "dependency_case_count",
    "published",
    "publication_status",
    "validation_status",
    "preview_artifact_ids"
  ],
  "properties": {
    "generation_result_schema_version": {
      "const": "3.0.0"
    },
    "outcome": {
      "enum": [
        "published",
        "planned",
        "no_executable_cases"
      ]
    },
    "requested_output_root": {
      "type": "string",
      "minLength": 1
    },
    "manifest_path": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "run_kind": {
      "const": "external_corpus"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "profile": {
      "$ref": "https://dicom-test-suite.local/schemas/manifest.schema.json#/$defs/profile"
    },
    "include_stress": {
      "type": "boolean"
    },
    "selector": {
      "$ref": "https://synth-dicom-gen.local/schemas/manifest-v2.schema.json#/properties/run/properties/selector"
    },
    "request_schema_version": {
      "const": "1.0.0"
    },
    "manifest_schema_version": {
      "const": "2.0.0"
    },
    "product_version": {
      "type": "string",
      "minLength": 1
    },
    "identity_projection": {
      "$ref": "https://synth-dicom-gen.local/schemas/manifest-v2.schema.json#/properties/identity_projection"
    },
    "selection_ledger": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "https://synth-dicom-gen.local/schemas/manifest-v2.schema.json#/properties/selection_ledger/items"
          },
          {
            "$ref": "#/$defs/preview_case"
          }
        ]
      }
    },
    "corpus_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "emitted_file_count": {
      "type": "integer",
      "minimum": 0
    },
    "output_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "selected_case_count": {
      "type": "integer",
      "minimum": 0
    },
    "direct_case_count": {
      "type": "integer",
      "minimum": 0
    },
    "dependency_case_count": {
      "type": "integer",
      "minimum": 0
    },
    "published": {
      "type": "boolean"
    },
    "publication_status": {
      "enum": [
        "published",
        "not_run"
      ]
    },
    "validation_status": {
      "enum": [
        "passed",
        "not_run"
      ]
    },
    "preview_artifact_ids": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "preview_case": {
      "type": "object",
      "required": [
        "case_id",
        "case_definition",
        "selection",
        "registry_status",
        "outcome",
        "reason_code",
        "dependency_case_ids",
        "artifact_paths"
      ],
      "properties": {
        "case_id": {
          "$ref": "https://synth-dicom-gen.local/schemas/manifest-v2.schema.json#/properties/selection_ledger/items/properties/case_id"
        },
        "case_definition": {
          "$ref": "https://synth-dicom-gen.local/schemas/manifest-v2.schema.json#/properties/selection_ledger/items/properties/case_definition"
        },
        "selection": {
          "$ref": "https://synth-dicom-gen.local/schemas/manifest-v2.schema.json#/properties/selection_ledger/items/properties/selection"
        },
        "registry_status": {
          "$ref": "https://synth-dicom-gen.local/schemas/manifest-v2.schema.json#/properties/selection_ledger/items/properties/registry_status"
        },
        "reason_code": {
          "$ref": "https://synth-dicom-gen.local/schemas/manifest-v2.schema.json#/properties/selection_ledger/items/properties/reason_code"
        },
        "dependency_case_ids": {
          "$ref": "https://synth-dicom-gen.local/schemas/manifest-v2.schema.json#/properties/selection_ledger/items/properties/dependency_case_ids"
        },
        "outcome": {
          "enum": [
            "ready",
            "unavailable",
            "planned",
            "skipped",
            "blocked",
            "deprecated"
          ]
        },
        "artifact_paths": {
          "type": "array",
          "maxItems": 0
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "published"
          }
        }
      },
      "then": {
        "properties": {
          "manifest_path": {
            "type": "string",
            "minLength": 1
          },
          "published": {
            "const": true
          },
          "publication_status": {
            "const": "published"
          },
          "validation_status": {
            "const": "passed"
          },
          "preview_artifact_ids": {
            "type": "null"
          },
          "selection_ledger": {
            "$ref": "https://synth-dicom-gen.local/schemas/manifest-v2.schema.json#/properties/selection_ledger"
          }
        }
      },
      "else": {
        "properties": {
          "manifest_path": {
            "type": "null"
          },
          "published": {
            "const": false
          },
          "publication_status": {
            "const": "not_run"
          },
          "validation_status": {
            "const": "not_run"
          },
          "emitted_file_count": {
            "const": 0
          },
          "output_bytes": {
            "const": 0
          },
          "preview_artifact_ids": {
            "type": "array"
          },
          "selection_ledger": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/preview_case"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "no_executable_cases"
          }
        }
      },
      "then": {
        "properties": {
          "preview_artifact_ids": {
            "maxItems": 0
          },
          "selection_ledger": {
            "items": {
              "properties": {
                "outcome": {
                  "not": {
                    "const": "ready"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
