{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dicom-test-suite.local/schemas/manifest.schema.json",
  "title": "DICOM Test Suite Run Manifest",
  "type": "object",
  "required": [
    "manifest_schema_version",
    "generated_at",
    "generator",
    "standards",
    "dependencies",
    "run",
    "files",
    "skipped_cases"
  ],
  "properties": {
    "manifest_schema_version": {
      "const": "0.1.0"
    },
    "generated_at": {
      "type": "string",
      "description": "Deterministic run timestamp in DICOM DT-compatible UTC form."
    },
    "generator": {
      "$ref": "#/$defs/generator"
    },
    "standards": {
      "$ref": "#/$defs/standards"
    },
    "dependencies": {
      "$ref": "#/$defs/dependencies"
    },
    "run": {
      "$ref": "#/$defs/run"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "skipped_cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skipped_case"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "profile": {
      "enum": [
        "smoke",
        "core",
        "extended",
        "legacy",
        "stress",
        "all",
        "negative",
        "fuzz"
      ]
    },
    "determinism": {
      "enum": ["byte_stable", "semantic_stable", "unstable"]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "string_map": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "generator": {
      "type": "object",
      "required": [
        "name",
        "version",
        "rustc_version",
        "target_triple",
        "cargo_lock_sha256",
        "feature_flags"
      ],
      "properties": {
        "name": {
          "const": "dicom-test-suite"
        },
        "version": {
          "type": "string"
        },
        "git_sha": {
          "type": ["string", "null"]
        },
        "rustc_version": {
          "type": "string"
        },
        "target_triple": {
          "type": "string"
        },
        "cargo_lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "feature_flags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "standards": {
      "type": "object",
      "required": [
        "dicom_base_edition",
        "include_final_text_after_base",
        "standards_lock_sha256",
        "dicom_standard_kb"
      ],
      "properties": {
        "dicom_base_edition": {
          "const": "2026b"
        },
        "include_final_text_after_base": {
          "type": "boolean"
        },
        "standards_lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "dicom_standard_kb": {
          "type": "object",
          "required": ["db_edition"],
          "properties": {
            "commit": {
              "type": ["string", "null"]
            },
            "db_edition": {
              "const": "2026b"
            },
            "db_sha256": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_manifest_sha256": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "required": ["dicom_rs_versions", "codec_versions"],
      "properties": {
        "dicom_rs_versions": {
          "$ref": "#/$defs/string_map"
        },
        "codec_versions": {
          "$ref": "#/$defs/string_map"
        }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": ["profile", "seed", "include_stress"],
      "properties": {
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "include_stress": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "required": [
        "case_id",
        "profile_membership",
        "path",
        "sha256",
        "size_bytes",
        "determinism",
        "recipe",
        "dicom",
        "uids",
        "references",
        "expected_capabilities",
        "expected_semantics",
        "expected_visual_checks",
        "validation",
        "known_stressors",
        "standards_evidence"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)+$"
        },
        "profile_membership": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profile"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "determinism": {
          "$ref": "#/$defs/determinism"
        },
        "recipe": {
          "$ref": "#/$defs/recipe"
        },
        "dicom": {
          "$ref": "#/$defs/dicom"
        },
        "uids": {
          "$ref": "#/$defs/uids"
        },
        "image": {
          "anyOf": [
            {
              "$ref": "#/$defs/image"
            },
            {
              "type": "null"
            }
          ]
        },
        "pixel_data": {
          "anyOf": [
            {
              "$ref": "#/$defs/pixel_data"
            },
            {
              "type": "null"
            }
          ]
        },
        "generation_backend": {
          "anyOf": [
            {
              "$ref": "#/$defs/generation_backend"
            },
            {
              "type": "null"
            }
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "expected_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "expected_semantics": {
          "type": "object",
          "additionalProperties": true
        },
        "expected_geometry": {
          "anyOf": [
            { "$ref": "#/$defs/expected_geometry" },
            { "type": "null" }
          ]
        },
        "expected_visual_checks": {
          "type": "object",
          "additionalProperties": true
        },
        "validation": {
          "$ref": "#/$defs/validation"
        },
        "known_stressors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "standards_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/standards_evidence"
          }
        }
      },
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "required": [
        "relationship",
        "source_case_id",
        "source_path",
        "sop_class_uid",
        "sop_instance_uid"
      ],
      "properties": {
        "relationship": {
          "type": "string"
        },
        "source_case_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)+$"
        },
        "source_path": {
          "type": "string"
        },
        "sop_class_uid": {
          "type": "string"
        },
        "sop_instance_uid": {
          "type": "string"
        },
        "series_instance_uid": {
          "type": ["string", "null"]
        },
        "frame_numbers": {
          "type": ["array", "null"],
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "expected_geometry": {
      "type": "object",
      "required": [
        "sort_basis",
        "sort_direction",
        "position_tolerance_mm",
        "spacing_tolerance_mm",
        "series_instance_count",
        "geometric_order_index",
        "position_along_normal_mm",
        "instance_number",
        "instance_number_order_index",
        "sorting_conflict_expected"
      ],
      "properties": {
        "sort_basis": {
          "const": "image_position_patient_projected_on_slice_normal"
        },
        "sort_direction": { "enum": ["ascending", "descending"] },
        "position_tolerance_mm": { "type": "number", "exclusiveMinimum": 0 },
        "spacing_tolerance_mm": { "type": "number", "exclusiveMinimum": 0 },
        "series_instance_count": { "type": "integer", "minimum": 2 },
        "geometric_order_index": { "type": "integer", "minimum": 1 },
        "position_along_normal_mm": { "type": "number" },
        "instance_number": { "type": "integer" },
        "instance_number_order_index": { "type": "integer", "minimum": 1 },
        "sorting_conflict_expected": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "recipe": {
      "type": "object",
      "required": ["recipe_id", "recipe_version", "recipe_parameters"],
      "properties": {
        "recipe_id": {
          "type": "string"
        },
        "recipe_version": {
          "type": "string"
        },
        "recipe_parameters": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "dicom": {
      "type": "object",
      "required": [
        "sop_class_uid",
        "sop_class_name",
        "iod_name",
        "modality",
        "transfer_syntax_uid",
        "transfer_syntax_name"
      ],
      "properties": {
        "sop_class_uid": {
          "type": "string"
        },
        "sop_class_name": {
          "type": "string"
        },
        "iod_name": {
          "type": "string"
        },
        "modality": {
          "type": "string"
        },
        "transfer_syntax_uid": {
          "type": "string"
        },
        "transfer_syntax_name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "uids": {
      "type": "object",
      "required": [
        "study_instance_uid",
        "series_instance_uid",
        "sop_instance_uid",
        "implementation_class_uid"
      ],
      "properties": {
        "study_instance_uid": {
          "type": "string"
        },
        "series_instance_uid": {
          "type": "string"
        },
        "sop_instance_uid": {
          "type": "string"
        },
        "frame_of_reference_uid": {
          "type": ["string", "null"]
        },
        "implementation_class_uid": {
          "type": "string"
        },
        "implementation_version_name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "required": [
        "rows",
        "columns",
        "frames",
        "samples_per_pixel",
        "photometric_interpretation",
        "bits_allocated",
        "planar_configuration"
      ],
      "properties": {
        "sample_type": {
          "enum": ["integer", "float32", "float64"]
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "columns": {
          "type": "integer",
          "minimum": 1
        },
        "frames": {
          "type": "integer",
          "minimum": 1
        },
        "samples_per_pixel": {
          "type": "integer",
          "minimum": 1
        },
        "photometric_interpretation": {
          "type": "string"
        },
        "bits_allocated": {
          "type": "integer",
          "minimum": 1
        },
        "bits_stored": {
          "type": "integer",
          "minimum": 1
        },
        "high_bit": {
          "type": "integer",
          "minimum": 0
        },
        "pixel_representation": {
          "enum": [0, 1]
        },
        "planar_configuration": {
          "type": ["integer", "null"],
          "enum": [0, 1, null]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "sample_type": {
                "enum": ["float32", "float64"]
              }
            },
            "required": ["sample_type"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["bits_stored"] },
                { "required": ["high_bit"] },
                { "required": ["pixel_representation"] }
              ]
            }
          },
          "else": {
            "required": ["bits_stored", "high_bit", "pixel_representation"]
          }
        }
      ]
    },
    "generation_backend": {
      "type": "object",
      "required": [
        "backend_id",
        "protocol_version",
        "name",
        "version",
        "dependency_lock_sha256",
        "executable_fingerprint",
        "entrypoint_fingerprint",
        "environment_fingerprint",
        "runtime_identity",
        "determinism",
        "warnings"
      ],
      "properties": {
        "backend_id": { "type": "string" },
        "protocol_version": { "const": "0.1.0" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "dependency_lock_sha256": { "$ref": "#/$defs/sha256" },
        "executable_fingerprint": { "$ref": "#/$defs/sha256" },
        "entrypoint_fingerprint": { "$ref": "#/$defs/sha256" },
        "environment_fingerprint": { "$ref": "#/$defs/sha256" },
        "runtime_identity": {
          "type": "object",
          "additionalProperties": true
        },
        "determinism": { "$ref": "#/$defs/determinism" },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "pixel_data": {
      "type": "object",
      "required": [
        "vr",
        "native_or_encapsulated",
        "value_length",
        "frame_count",
        "frame_hashes"
      ],
      "properties": {
        "vr": {
          "enum": ["OB", "OW", "OF", "OD", "OL", "OV", "UN"]
        },
        "native_or_encapsulated": {
          "enum": ["native", "encapsulated", "absent"]
        },
        "value_length": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "frame_count": {
          "type": "integer",
          "minimum": 0
        },
        "frame_hashes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "codec": {
          "anyOf": [
            {
              "$ref": "#/$defs/codec_backend"
            },
            {
              "type": "null"
            }
          ]
        },
        "encapsulated_pixel_data": {
          "anyOf": [
            {
              "$ref": "#/$defs/encapsulated_pixel_data"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "native_or_encapsulated": {
                "const": "encapsulated"
              }
            },
            "required": ["native_or_encapsulated"]
          },
          "then": {
            "required": ["encapsulated_pixel_data"]
          }
        }
      ]
    },
    "encapsulated_pixel_data": {
      "type": "object",
      "required": [
        "basic_offset_table",
        "fragments_per_frame",
        "extended_offset_table",
        "compressed_frame_hashes"
      ],
      "properties": {
        "basic_offset_table": {
          "type": "object",
          "required": ["present", "populated", "offset_count"],
          "properties": {
            "present": {
              "const": true
            },
            "populated": {
              "type": "boolean"
            },
            "offset_count": {
              "type": "integer",
              "minimum": 0
            },
            "offsets": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "additionalProperties": false
        },
        "fragments_per_frame": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "fragments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/encapsulated_fragment"
          }
        },
        "extended_offset_table": {
          "type": "object",
          "required": [
            "present",
            "lengths_present",
            "offset_count",
            "length_count"
          ],
          "properties": {
            "present": {
              "type": "boolean"
            },
            "lengths_present": {
              "type": "boolean"
            },
            "offset_count": {
              "type": "integer",
              "minimum": 0
            },
            "length_count": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "compressed_frame_hashes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha256"
          }
        }
      },
      "additionalProperties": false
    },
    "codec_backend": {
      "type": "object",
      "required": [
        "backend_id",
        "backend_kind",
        "display_name",
        "version",
        "transfer_syntax_uid",
        "feature_gate",
        "determinism"
      ],
      "properties": {
        "backend_id": {
          "type": "string"
        },
        "backend_kind": {
          "enum": ["native", "dicom_rs_feature", "external_command"]
        },
        "display_name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "transfer_syntax_uid": {
          "type": "string"
        },
        "feature_gate": {
          "type": ["string", "null"]
        },
        "determinism": {
          "$ref": "#/$defs/determinism"
        },
        "runtime_identity": {
          "type": "object",
          "required": [
            "command",
            "executable_path",
            "executable_sha256",
            "version",
            "version_source",
            "encoder_options"
          ],
          "properties": {
            "command": {
              "type": "string"
            },
            "executable_path": {
              "type": "string"
            },
            "executable_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "version": {
              "type": ["string", "null"]
            },
            "version_source": {
              "type": "string"
            },
            "encoder_options": {
              "type": "object",
              "required": ["input_format", "reversible", "num_decomps"],
              "properties": {
                "input_format": {
                  "type": "string"
                },
                "reversible": {
                  "type": "boolean"
                },
                "num_decomps": {
                  "type": "integer"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "encapsulated_fragment": {
      "type": "object",
      "required": [
        "frame_index",
        "item_start_offset",
        "compressed_length",
        "padded_length"
      ],
      "properties": {
        "frame_index": {
          "type": "integer",
          "minimum": 0
        },
        "item_start_offset": {
          "type": "integer",
          "minimum": 0
        },
        "compressed_length": {
          "type": "integer",
          "minimum": 0
        },
        "padded_length": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": ["status", "internal", "standards", "external"],
      "properties": {
        "status": {
          "enum": ["passed", "failed", "skipped", "unavailable"]
        },
        "internal": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validation_result"
          }
        },
        "standards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validation_result"
          }
        },
        "external": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validation_result"
          }
        }
      },
      "additionalProperties": false
    },
    "validation_result": {
      "type": "object",
      "required": ["name", "status"],
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "enum": ["passed", "failed", "skipped", "unavailable"]
        },
        "message": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": true
    },
    "standards_evidence": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": {
          "type": "string"
        },
        "edition": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "covered": {
          "type": "boolean"
        },
        "part": {
          "type": "string"
        },
        "anchor": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "skipped_case": {
      "type": "object",
      "required": ["case_id", "status", "reason_code", "message"],
      "properties": {
        "case_id": {
          "type": "string"
        },
        "status": {
          "enum": ["skipped", "blocked", "unavailable"]
        },
        "reason_code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "recheck_phase": {
          "type": ["string", "null"]
        },
        "standards_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/standards_evidence"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
