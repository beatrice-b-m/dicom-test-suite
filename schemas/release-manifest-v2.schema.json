{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synth-dicom-gen.local/schemas/release-manifest-v2.schema.json",
  "title": "Synth DICOM Gen Release Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_manifest_schema_version",
    "product",
    "source",
    "target",
    "enabled_features",
    "version_result",
    "capabilities_result",
    "identity_domains",
    "files"
  ],
  "properties": {
    "release_manifest_schema_version": { "const": "2.0.0" },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "synth-dicom-gen" },
        "version": { "$ref": "https://synth-dicom-gen.local/schemas/version-result-v2.schema.json#/$defs/semver" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "dirty"],
      "properties": {
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "dirty": { "type": "boolean" }
      }
    },
    "target": { "type": "string", "minLength": 1 },
    "enabled_features": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "version_result": { "$ref": "https://synth-dicom-gen.local/schemas/version-result-v2.schema.json" },
    "capabilities_result": { "$ref": "https://synth-dicom-gen.local/schemas/capabilities-result-v2.schema.json" },
    "identity_domains": { "$ref": "https://synth-dicom-gen.local/schemas/version-result-v2.schema.json#/$defs/identity_domains" },
    "legacy_product_resources": { "$ref": "https://synth-dicom-gen.local/schemas/version-result-v2.schema.json#/$defs/product_resources" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^[^/](?:.*[^/])?$" },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
