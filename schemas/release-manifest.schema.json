{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dicom-test-suite.invalid/schemas/release-manifest.schema.json",
  "title": "dicom-test-suite release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_manifest_schema_version",
    "product",
    "source",
    "target",
    "enabled_features",
    "version_result",
    "capabilities_result",
    "files"
  ],
  "properties": {
    "release_manifest_schema_version": { "const": "1.0.0" },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "dicom-test-suite" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "dirty"],
      "properties": {
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "dirty": { "type": "boolean" }
      }
    },
    "target": { "type": "string", "minLength": 1 },
    "enabled_features": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "version_result": { "type": "object" },
    "capabilities_result": { "type": "object" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^[^/](?:.*[^/])?$" },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
