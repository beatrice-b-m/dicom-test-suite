{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dicom-test-suite.local/schemas/standards-result.schema.json",
  "title": "DICOM Test Suite Standards Result",
  "type": "object",
  "required": ["standards_result_schema_version", "operation", "record_count", "records"],
  "properties": {
    "standards_result_schema_version": { "const": "1.0.0" },
    "operation": { "enum": ["check_lock", "gaps"] },
    "record_count": { "type": "integer", "minimum": 0 },
    "records": { "type": "array", "items": { "type": "object" } }
  },
  "additionalProperties": false
}
