{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synth-dicom-gen.local/schemas/transaction-report.schema.json",
  "title": "DICOM Test Suite Protocol Transaction Report",
  "type": "object",
  "required": ["contract_version", "transactions", "summary"],
  "properties": {
    "contract_version": { "const": "0.1.0" },
    "transactions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/transaction" }
    },
    "summary": { "$ref": "#/$defs/report_summary" }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9]+(\\.[0-9]+)*$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)+$"
    },
    "tool_fingerprint": {
      "type": "object",
      "required": ["id", "version", "executable_sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "executable_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "peer_fingerprint": {
      "type": "object",
      "required": ["id", "implementation", "version", "artifact_sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "implementation": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["case_id", "path", "sha256", "sop_instance_uid"],
      "properties": {
        "case_id": { "$ref": "#/$defs/case_id" },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sop_instance_uid": { "$ref": "#/$defs/uid" }
      },
      "additionalProperties": false
    },
    "passed_outcome": {
      "type": "object",
      "required": ["status"],
      "properties": { "status": { "const": "passed" } },
      "additionalProperties": false
    },
    "rejected_outcome": {
      "type": "object",
      "required": ["status", "code"],
      "properties": {
        "status": { "const": "rejected" },
        "code": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "timeout_outcome": {
      "type": "object",
      "required": ["status", "limit_milliseconds"],
      "properties": {
        "status": { "const": "timeout" },
        "limit_milliseconds": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "crash_outcome": {
      "type": "object",
      "required": ["status", "exit_code", "signal"],
      "properties": {
        "status": { "const": "crash" },
        "exit_code": { "type": ["integer", "null"] },
        "signal": { "type": ["integer", "null"] }
      },
      "additionalProperties": false
    },
    "unavailable_outcome": {
      "type": "object",
      "required": ["status", "blocker_code", "reason"],
      "properties": {
        "status": { "const": "unavailable" },
        "blocker_code": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["ordinal", "operation", "outcome", "detail"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "outcome": {
          "oneOf": [
            { "$ref": "#/$defs/passed_outcome" },
            { "$ref": "#/$defs/rejected_outcome" },
            { "$ref": "#/$defs/timeout_outcome" },
            { "$ref": "#/$defs/crash_outcome" },
            { "$ref": "#/$defs/unavailable_outcome" }
          ]
        },
        "detail": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "dimse_section": {
      "type": "object",
      "required": ["kind", "calling_ae_title", "called_ae_title", "presentation_contexts", "operations"],
      "properties": {
        "kind": { "const": "dimse" },
        "calling_ae_title": { "type": "string", "minLength": 1, "maxLength": 16 },
        "called_ae_title": { "type": "string", "minLength": 1, "maxLength": 16 },
        "presentation_contexts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "dicomweb_section": {
      "type": "object",
      "required": ["kind", "server_identity", "services", "media_types"],
      "properties": {
        "kind": { "const": "dicomweb" },
        "server_identity": { "type": "string", "minLength": 1 },
        "services": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "media_types": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "tls_section": {
      "type": "object",
      "required": [
        "kind",
        "protocol_version",
        "cipher_suite",
        "mutual_tls",
        "user_identity_type",
        "root_ca_identity_id",
        "server_identity_id",
        "client_identity_id"
      ],
      "properties": {
        "kind": { "const": "tls" },
        "protocol_version": { "type": "string", "minLength": 1 },
        "cipher_suite": { "type": "string", "minLength": 1 },
        "mutual_tls": { "type": "boolean" },
        "user_identity_type": { "type": ["string", "null"] },
        "root_ca_identity_id": { "type": "string", "minLength": 1 },
        "server_identity_id": { "type": "string", "minLength": 1 },
        "client_identity_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "pki_fixture": {
      "type": "object",
      "required": [
        "identity_id",
        "certificate_sha256",
        "certificate_fingerprint_sha256",
        "public_key_sha256"
      ],
      "properties": {
        "identity_id": { "type": "string", "minLength": 1 },
        "certificate_sha256": { "$ref": "#/$defs/sha256" },
        "certificate_fingerprint_sha256": { "$ref": "#/$defs/sha256" },
        "public_key_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "transaction": {
      "type": "object",
      "required": [
        "contract_version",
        "case_id",
        "transaction_id",
        "harness",
        "peer",
        "provider_relationship",
        "sources",
        "steps",
        "section",
        "pki_fixtures",
        "status"
      ],
      "properties": {
        "contract_version": { "const": "0.1.0" },
        "case_id": { "$ref": "#/$defs/case_id" },
        "transaction_id": { "type": "string", "pattern": "^txn-[0-9a-f]{32}$" },
        "harness": { "$ref": "#/$defs/tool_fingerprint" },
        "peer": { "$ref": "#/$defs/peer_fingerprint" },
        "provider_relationship": { "enum": ["independent", "same_provider"] },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        },
        "section": {
          "oneOf": [
            { "$ref": "#/$defs/dimse_section" },
            { "$ref": "#/$defs/dicomweb_section" },
            { "$ref": "#/$defs/tls_section" }
          ]
        },
        "pki_fixtures": {
          "type": "array",
          "items": { "$ref": "#/$defs/pki_fixture" }
        },
        "status": { "enum": ["passed", "failed", "unavailable"] }
      },
      "additionalProperties": false
    },
    "outcome_counts": {
      "type": "object",
      "required": ["passed", "failed", "unavailable"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "unavailable": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "report_summary": {
      "type": "object",
      "required": ["dimse", "dicomweb", "tls", "total"],
      "properties": {
        "dimse": { "$ref": "#/$defs/outcome_counts" },
        "dicomweb": { "$ref": "#/$defs/outcome_counts" },
        "tls": { "$ref": "#/$defs/outcome_counts" },
        "total": { "$ref": "#/$defs/outcome_counts" }
      },
      "additionalProperties": false
    }
  }
}
